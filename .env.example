# Copy to .env for local development:  cp .env.example .env
# Placeholders only. Never commit a real .env file or production secrets.
# Full list and meaning: readmes/README-infrastructure-deployment.md §3.3

# --- Django ---------------------------------------------------------------
DEBUG=True
SECRET_KEY=replace-with-a-long-random-local-secret
ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Origins whose requests Django trusts for CSRF (the Vite dev server locally).
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# --- Authentication (read from Phase 3) -------------------------------------
JWT_SIGNING_KEY=replace-with-a-different-long-random-local-secret
# Send the refresh cookie over HTTPS only. Must be True in production.
REFRESH_COOKIE_SECURE=False

# --- PostgreSQL (also used to initialise the local postgres container) ----
DB_NAME=urban_vault
DB_USER=urban_vault
DB_PASSWORD=replace-with-a-local-database-password
DB_HOST=postgres
DB_PORT=5432

# --- Redis (Celery broker only) -------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Notifications (read from Phase 5) ---------------------------------------
# How long a published-but-unprocessed outbox row waits before it is re-published.
NOTIFICATION_REDISPATCH_INTERVAL_SECONDS=300

# --- Demo data (read from Phase 2) --------------------------------------------
# Password given to every seeded demo account. Local evaluation only.
SEED_DEMO_PASSWORD=replace-with-a-local-demo-password

# --- Frontend (Vite) --------------------------------------------------------
# Base path the React app uses for API calls (same origin via the Vite proxy).
VITE_API_BASE_URL=/api/v1
# Show the development-only demo-account picker on the login screen.
VITE_ENABLE_DEMO_ACCOUNTS=true
# Where the Vite dev server forwards /api requests (inside Docker Compose).
API_PROXY_TARGET=http://backend:8000
